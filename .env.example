# --- Database (Neon / Supabase / any Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dataroom"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Google sign-in (optional; the button appears only when both are set) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- File storage ---
# When set, uploads go to Vercel Blob (required in production).
# When empty, files are stored on the local disk under .uploads/ (dev only).
# BLOB_READ_WRITE_TOKEN=""
